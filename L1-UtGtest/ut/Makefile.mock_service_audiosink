.PHONY: mock_service

HAL_DIR ?= $(CURDIR)

MOCK_SERVICE_SONAME := maudiosink

MOCK_SERVICE_BIN := AudioSinkService
MOCK_SERVICE_LIB := lib$(MOCK_SERVICE_SONAME).so


AIDL_GEN_DIR ?= $(HAL_DIR)/src/gen/hal/current

MOCK_SERVICE_DIR ?= $(HAL_DIR)/audiosink_mock/src/service

BUILD_DIR ?= $(HAL_DIR)/build


$(info The value of MY_VAR is: $(MOCK_SERVICE_DIR))

AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/Capabilities.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/ErrorCode.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/IAudioSinkController.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/IAudioSinkControllerListener.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/IAudioSink.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/IAudioSinkEventListener.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/IAudioSinkManager.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/PlatformCapabilities.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/Property.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/Volume.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiosink/VolumeRamp.cpp

AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/AVSource.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/HALError.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/PropertyValue.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/State.cpp

AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/Capabilities.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/ChannelType.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/Codec.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/CSDAudioFormat.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/ErrorCode.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/FrameMetadata.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderController.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderControllerListener.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoder.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderEventListener.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/IAudioDecoderManager.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/PCMFormat.cpp
AIDL_GEN_SRC += ${AIDL_GEN_DIR}/cpp/com/rdk/hal/audiodecoder/Property.cpp


MOCK_SERVICE_LIB_SRC := $(AIDL_GEN_SRC)
MOCK_SERVICE_LIB_SRC += $(MOCK_SERVICE_DIR)/AudioSink.cpp

MOCK_SERVICE_BIN_SRC := $(MOCK_SERVICE_DIR)/AudioSinkService.cpp


# FIXME: to be compile out of source tree

MOCK_SERVICE_INC_FLAGS := -I$(AIDL_GEN_DIR)/h
MOCK_SERVICE_INC_FLAGS += -I$(BUILD_DIR)/usr/include
MOCK_SERVICE_INC_FLAGS += -I$(MOCK_SERVICE_DIR)

MOCK_SERVICE_LD_LIBS := -lbinder -lutils

MOCK_SERVICE_LDFLAGS := -L$(BUILD_DIR)/usr/lib
MOCK_SERVICE_LDFLAGS += -Wl,-rpath-link=$(BUILD_DIR)/usr/lib


MOCK_SERVICE_CFLAGS := -Wall -Wextra -std=c++17 -ggdb

mock_service: $(MOCK_SERVICE_BIN) $(MOCK_SERVICE_LIB)

$(MOCK_SERVICE_LIB): $(MOCK_SERVICE_LIB_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $^ -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $(MOCK_SERVICE_LIB) $(BUILD_DIR)/usr/lib



$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_LIB)
$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_BIN_SRC:%.cpp=%.o)
	g++ $(MOCK_SERVICE_LDFLAGS) \
		$(MOCK_SERVICE_BIN_SRC:%.cpp=%.o) -o $@ \
		$(MOCK_SERVICE_LD_LIBS) -l$(MOCK_SERVICE_SONAME)
	        
	install $(MOCK_SERVICE_BIN) install $(BUILD_DIR)/usr/lib

$(MOCK_SERVICE_BIN_SRC:%.cpp=%.o):$(MOCK_SERVICE_BIN_SRC)
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -c $< -o $@

# do not clash with `ut-core` by chaning the object file name to .o.1
%.o: %.cpp
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -fPIC -c $< -o $@

